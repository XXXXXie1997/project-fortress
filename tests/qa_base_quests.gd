extends SceneTree
func _initialize():
 var defs = JSON.parse_string(FileAccess.get_file_as_string("res://data/items.json")).items
 var inv = InventoryService.new(defs)
 var s = WorldState.fresh()
 inv.setup(s)
 var b = BuildingService.new(inv, JSON.parse_string(FileAccess.get_file_as_string("res://data/buildings.json")))
 b.setup(s)
 inv.spawn(s,"scrap","warehouse",100)
 var cam = Rect2i(0,0,24,18)
 var before = JSON.stringify(s)
 assert(b.build(s,"farm",[0,0],cam) == "")
 assert(b.build(s,"farm",[10,16],cam) == "")
 assert(b.build(s,"farm",[4,4],Rect2i(0,0,2,2)) == "")
 assert(not b.demolish(s,"building_1"))
 assert(JSON.stringify(s) == before)
 s.base.combat = true
 before = JSON.stringify(s)
 assert(b.build(s,"farm",[4,4],cam) == "")
 assert(not b.move(s,"building_1",[4,4],cam))
 assert(not b.upgrade(s,"building_1"))
 assert(JSON.stringify(s) == before)
 s.base.combat = false
 var id = b.build(s,"farm",[4,4],cam)
 assert(inv.count(s,"scrap","warehouse") == 90)
 assert(b.demolish(s,id))
 assert(inv.count(s,"scrap","warehouse") == 100)
 var p = ProductionService.new(b,JSON.parse_string(FileAccess.get_file_as_string("res://data/recipes.json")).recipes)
 assert(p.order(s,"building_4","medical",3))
 assert(s.base.energy_store.energy == 185)
 s.base.buildings.building_4.durability = 0
 p.settle(s,"qa:1")
 assert(s.base.buildings.building_4.order.remaining == 3)
 assert(b.repair(s,"building_4"))
 p.settle(s,"qa:2")
 assert(s.base.buildings.building_4.order.remaining == 2)
 assert(p.cancel(s,"building_4"))
 assert(s.base.energy_store.energy == 195)
 assert(inv.count(s,"medical_needle","warehouse") == 1)
 print("QA301_EXTRA_PASS")
 var q = QuestService.new(inv)
 var t = TechnologyService.new(inv)
 assert(t.unlock(s,"storage",true).ok)
 assert(t.unlock(s,"agriculture",true).ok)
 var rng = RandomNumberGenerator.new()
 rng.seed = 42
 q.refresh(s,rng)
 before = JSON.stringify(s)
 q.refresh(s,rng)
 assert(JSON.stringify(s) == before)
 for offer in s.quests.offers.keys(): assert(q.accept(s,offer,true).ok)
 assert(q.accept(s,"main_1",true).ok)
 s.day = 2
 q.refresh(s,rng)
 assert(not q.accept(s,s.quests.offers.keys()[0],true).ok)
 q.record(s,"reach","map_1_relay","evt")
 q.record(s,"reach","map_1_relay","evt")
 assert(s.quests.active.main_1.progress == 1)
 s.day = 3
 q.expire(s)
 assert(s.quests.active.size() == 1)
 assert(q.deliver(s,"main_1",true).ok)
 assert(s.quests.pending_stages[0].effective_day == 4)
 before = JSON.stringify(s)
 assert(not q.deliver(s,"main_1",true).ok)
 assert(JSON.stringify(s) == before)
 q.new_survivor(s)
 assert(s.base.technology.has("agriculture"))
 assert(s.quests.active.is_empty() and s.quests.pending_stages.is_empty())
 print("QA312_EXTRA_PASS")
 quit()
