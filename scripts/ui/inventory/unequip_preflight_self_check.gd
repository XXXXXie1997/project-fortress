extends SceneTree
func _initialize():call_deferred("run")
func fixture() -> Dictionary:
	var s:=WorldState.fresh()
	var inv:=InventoryService.new(JSON.parse_string(FileAccess.get_file_as_string("res://data/items.json")).items)
	inv.setup(s)
	var pack:=inv.spawn(s,"backpack_small","warehouse")
	inv.equip(s,pack.id,"backpack")
	var overflow:=inv.spawn(s,"scrap","bag",1)
	inv.relocate(s,overflow.id,Vector2i(4,0),false)
	var p:=InventoryPanel.new();p.bind_state(s,inv);root.add_child(p);p.at_base=false;p.open_panel()
	return {"s":s,"inv":inv,"pack":pack.id,"overflow":overflow.id,"p":p}
func run():
	var f:=fixture()
	var block:Dictionary=f.inv.spawn(f.s,"medical_needle","bag",1)
	assert(f.inv.relocate(f.s,block.id,Vector2i.ZERO,false))
	var before:=WorldState.encode(f.s)
	assert(not f.p.transfer_item(f.pack,"bag",Vector2i.ZERO,true))
	assert(not f.p.dialog.visible and not f.p.last_feedback.is_empty())
	assert(WorldState.encode(f.s)==before)
	f.p.queue_free()
	await process_frame
	f=fixture()
	before=WorldState.encode(f.s)
	assert(not f.p.transfer_item(f.pack,"bag",Vector2i.ZERO,true))
	assert(f.p.dialog.visible and WorldState.encode(f.s)==before)
	f.p.dialog.hide()
	assert(WorldState.encode(f.s)==before)
	assert(not f.p.transfer_item(f.pack,"bag",Vector2i.ZERO,true))
	f.p.pending.call()
	assert(f.s.player.equipment.backpack=="")
	assert(f.s.items[f.pack].container_id=="bag" and f.s.items[f.pack].cell==[0,0])
	assert(f.s.items[f.overflow].container_id=="ground")
	f.p.queue_free()
	await process_frame
	f=fixture()
	assert(not f.p.transfer_item(f.pack,"bag",Vector2i.ZERO,true))
	block=f.inv.spawn(f.s,"medical_needle","bag",1)
	before=WorldState.encode(f.s)
	f.p.pending.call()
	assert(WorldState.encode(f.s)==before and not f.p.last_feedback.is_empty())
	f.p.queue_free()
	await process_frame
	print("UNEQUIP_PREFLIGHT_PASS")
	quit()
