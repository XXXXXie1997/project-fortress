extends SceneTree
func _initialize():
 var s:=WorldState.fresh()
 var inv:=InventoryService.new(JSON.parse_string(FileAccess.get_file_as_string("res://data/items.json")).items)
 inv.setup(s)
 var e:=ExplorationService.new(inv,JSON.parse_string(FileAccess.get_file_as_string("res://data/maps/exploration.json")).maps)
 assert(e.start(s,"suburbs","south","day"))
 assert(e.kill(s,"infected_01"))
 assert(e.open_search(s,"crate_01"))
 e.tick_search(s,0.2)
 e.close_search(s)
 e.open_search(s,"crate_01")
 e.tick_search(s,0.3)
 assert(e.box(s,"crate_01").revealed.is_empty())
 e.tick_search(s,0.3)
 assert(e.take_all(s,"crate_01").size()==1)
 assert(e.exit_map(s,"armory_road"))
 assert(e.exit_map(s,"road"))
 assert(s.expedition.maps.suburbs.enemies.infected_01.dead)
 s.player.hp=2; s.player.max_hp=100
 assert(e.finish(s,true,[20,30]).ok)
 assert(s.player.hp==100 and inv.count(s,"medical_needle")==0)
 assert(not e.start(s,"suburbs","south","day"))
 assert(e.start(s,"suburbs","south","night"))
 assert(not s.expedition.maps.suburbs.enemies.infected_01.get("dead",false))
 assert(e.open_search(s,"death_1"))
 assert(e.take_all(s,"death_1").size()==1)
 assert(not WorldState.decode(WorldState.encode(s)).is_empty())
 e.expire(s,4)
 assert(s.world.exploration.death_bags.is_empty())
 print("EXPLORATION SELF CHECK PASSED")
 quit()
