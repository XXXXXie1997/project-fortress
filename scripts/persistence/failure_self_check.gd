extends SceneTree
const Save = preload("res://scripts/persistence/save_service.gd")
func _initialize():
 var path: String=OS.get_cmdline_user_args()[0]
 DirAccess.make_dir_recursive_absolute(path)
 var blocker:=FileAccess.open(path.path_join("blocker"),FileAccess.WRITE)
 blocker.store_string("not_directory");blocker.close()
 var bad:=Save.new(path.path_join("blocker"))
 assert(bad.request("slot",WorldState.fresh()).ok)
 assert(not bad.flush().ok and bad.pending.size()==1)
 var svc:=Save.new(path.path_join("good"))
 svc.request("slot",WorldState.fresh());assert(svc.flush().ok)
 var target: String=svc.root.path_join("slot/latest.json")
 var f:=FileAccess.open(target,FileAccess.WRITE)
 f.store_string("{truncated");f.close()
 assert(not svc.load_snapshot("slot").ok)
 svc.request("slot",WorldState.fresh())
 assert(not svc.flush().ok)
 assert(FileAccess.get_file_as_string(target)=="{truncated")
 f=FileAccess.open(target,FileAccess.WRITE)
 var payload:=JSON.stringify(WorldState.fresh())
 f.store_string(JSON.stringify({"format":999,"type":"world","payload":payload,"sha256":payload.sha256_text()}));f.close()
 assert(not svc.load_snapshot("slot").ok)
 f=FileAccess.open(target,FileAccess.WRITE)
 f.store_string(JSON.stringify({"format":1,"type":"world","payload":payload,"sha256":"wrong"}));f.close()
 assert(not svc.load_snapshot("slot").ok)
 print("SAVE CORRUPTION AND REAL WRITE FAILURE PASSED")
 quit()
